# Application
APP_NAME=AI Software Evolution Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173

# MongoDB (Phase 1+)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ai_software_evolution

# Server-side sessions (Phase 1) — generate a long random string
SESSION_SECRET=change-me-to-a-long-random-secret
SESSION_COOKIE_NAME=ase_session
SESSION_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# Google OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# ChromaDB (Phase 4) — leave empty to use %TEMP%/ase_chroma (recommended on OneDrive).
# Example: CHROMA_PERSIST_DIR=./data/chroma
CHROMA_PERSIST_DIR=

# Gemini — shared API key for architecture (Phase 3) and RAG chat (Phase 4)
GEMINI_API_KEY=
# Architecture generation
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ARCHITECTURE_FALLBACK_MODEL=gemini-3.1-flash-lite
# Repository chatbot
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.1-flash-lite

# Embeddings (Phase 4)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Repository data (Phase 2+)
# Leave empty to use the OS temp folder (recommended on OneDrive).
# Example override: REPO_CLONE_DIR=C:\Temp\ase_repos
REPO_CLONE_DIR=
